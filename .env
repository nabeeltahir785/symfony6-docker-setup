# ============================================================================
# Symfony + Docker Environment Configuration
# This file is committed to the repository and contains default values.
# Override locally with .env.local (gitignored).
# ============================================================================

# --- Symfony Application ---
APP_ENV=dev
APP_SECRET=change-me-in-production-with-a-real-secret
APP_DEBUG=1

# --- Database (PostgreSQL) ---
# Docker Compose variables (used in docker-compose.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_DB=app
POSTGRES_PORT=5432

# Symfony DATABASE_URL (overridden by docker-compose.yml environment section)
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- Messenger ---
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# --- Mailer (Mailpit) ---
MAILER_DSN=smtp://mailpit:1025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- FrankenPHP / Caddy ---
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
XDEBUG_MODE=off
FRANKENPHP_WORKER_CONFIG=watch

# --- Debug (var dumper server) ---
VAR_DUMPER_SERVER=host.docker.internal:9912
