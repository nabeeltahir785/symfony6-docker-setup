# ============================================================================
# FrankenPHP / Caddy Configuration
# Serves Symfony from /app/public using Worker Mode
# ============================================================================

{
	# Disable automatic certificate installation in local/CI environments
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	# Enable the admin API for health checks on :2019
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}

		# Structured JSON logging (forwarded to stdout by default)
		format json
	}

	# Document root
	root /app/public

	# Response compression
	encode zstd br gzip

	# Security headers
	header {
		# Clickjacking protection
		X-Frame-Options "SAMEORIGIN"
		# XSS protection
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Disable FLoC / Topics
		?Permissions-Policy "browsing-topics=()"
		# Remove server identification
		-Server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Route non-file requests to Symfony front controller
	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	# FrankenPHP handler with worker mode
	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	# Serve static files but hide PHP source files
	file_server {
		hide *.php
	}
}
